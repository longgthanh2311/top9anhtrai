<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Tặng Phương Linh</title>
  <style>
    body {
      background-color: #ffe6f0;
      font-family: 'Arial', sans-serif;
      margin: 0;
      padding: 0;
      text-align: center;
      overflow-x: hidden;
    }

    /* Trái tim chính diện ở trên giữa */
    .top-heart {
      margin: 20px auto 10px auto;
      width: 120px;
      height: 100px;
      background: pink;
      animation: beat 1s infinite, sparkle 2s infinite;
      border-radius: 50% 50% 0 0;
      clip-path: path("M60 20 C20 -10, -10 40, 60 100 C130 40, 100 -10, 60 20 Z");
    }

    @keyframes beat {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.2); }
    }

    @keyframes sparkle {
      0%, 100% {
        box-shadow: 0 0 15px #ff99cc, 0 0 30px #ff66b2, 0 0 45px #ff3399;
      }
      50% {
        box-shadow: 0 0 25px #ff66b2, 0 0 50px #ff3399, 0 0 70px #ff0066;
      }
    }

    /* Ảnh góc phải */
    .corner-image {
      position: absolute;
      top: 20px;
      right: 20px;
      width: 80px;
      z-index: 10;
    }

    h1 {
      color: #ff3399;
      font-size: 1.5em; /* nhỏ lại cho vừa khung */
      margin: 0;
    }

    p {
      color: #333;
      font-size: 1.1em;
      margin-top: 10px;
    }

    .images {
      display: flex;
      justify-content: center;
      align-items: flex-start;
      gap: 20px;
      margin-top: 20px;
    }

    .images img {
      border: 5px solid #ff99cc;
      border-radius: 15px;
    }

    .question-box {
      background: white;
      border: 2px solid #ccc;
      border-radius: 10px;
      padding: 20px;
      width: 250px;
      text-align: center;
    }

    .question-box h2 {
      margin-bottom: 15px;
      color: #333;
      font-size: 1.1em;
    }

    .options {
      display: flex;
      justify-content: space-around;
    }

    .options button {
      border: 2px solid #3399ff;
      background: none;
      color: #3399ff;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 1em;
      cursor: pointer;
      transition: 0.3s;
    }

    .options button:hover {
      background: #3399ff;
      color: white;
    }

    .answer {
      margin-top: 15px;
      font-size: 1.1em;
      color: #ff3399;
      font-weight: bold;
    }

    .hello-section {
      display: flex;
      gap: 20px;
      justify-content: center;
      align-items: center;
    }
  </style>
</head>
<body>
  <!-- Trái tim ở trên giữa -->
  <div class="top-heart"></div>

  <!-- Ảnh góc phải -->
  <img src="https://i.postimg.cc/0yPDfCs9/thanh-preview-rev-1.png" alt="Ảnh góc phải" class="corner-image">

  <h1>Phương Linh 💖</h1>
  <p>Bạn Thành gửi tặng bạn Linh<br>
     mong bạn xem rồi về nhà cẩn thận nhó<br>
     mãi iu 🤍</p>

  <div class="images">
    <img src="https://i.postimg.cc/ZKDdhhkH/linhh.jpg" alt="Ảnh Phương Linh" width="250">
    <div class="hello-section">
      <img src="https://media3.giphy.com/media/10a8AOSeP6Rqfu/giphy.gif" alt="Hello Kitty gif" width="200">
      <div class="question-box">
        <h2>Bạn Linh có thích không?</h2>
        <div class="options">
          <button onclick="showAnswer('yes')">Có</button>
          <button onclick="showAnswer('no')">Không</button>
        </div>
        <div class="answer" id="answer"></div>
      </div>
    </div>
  </div>

  <script>
    function showAnswer(choice) {
      const answerBox = document.getElementById('answer');
      if (choice === 'yes') {
        answerBox.textContent = "Đi chơi Noel với tớ nhé 🎄✨";
      } else {
        answerBox.textContent = "Bạn Linh làm bạn Thành bùn rồi 😢";
      }
    }
  </script>
</body>
</html>
